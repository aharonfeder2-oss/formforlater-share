<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex, nofollow">
<title>Shared form answers</title>
<style>
  :root{
    --ink:#0C1014;--ink-raised:#131920;--rule:#212A34;--rule-strong:#2E3A46;
    --paper:#E9E4D9;--paper-dim:#A8AFB8;--paper-faint:#6B7683;
    --brass:#C9873A;--brass-dim:#8A5D28;--alarm:#C4574B;--redact:#2B333D;
    --font-display:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
    --font-ui:"Segoe UI Variable Text","Segoe UI",system-ui,-apple-system,sans-serif;
    --font-mono:"Cascadia Mono",Consolas,"SF Mono",ui-monospace,monospace;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--ink);color:var(--paper);font-family:var(--font-ui);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}
  .wrap{max-width:720px;margin:0 auto;padding:48px 16px 80px}
  h1{font-family:var(--font-display);font-size:1.75rem;margin:0}
  .eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--paper-faint);font-weight:600}
  .meta{color:var(--paper-faint);font-family:var(--font-mono);font-size:12px;margin:8px 0 24px}
  .notice{border:1px solid rgba(196,87,75,.45);background:rgba(196,87,75,.10);border-radius:6px;padding:12px 16px;color:#E8B4AE;line-height:1.55;margin:24px 0}
  .notice strong{color:#F2CDC8}
  .steps{display:flex;gap:8px;flex-wrap:wrap;border-bottom:1px solid var(--rule);padding-bottom:12px;margin:24px 0 16px}
  .step{display:flex;gap:8px;align-items:baseline;padding:8px 12px;background:transparent;border:1px solid var(--rule);border-radius:6px;color:var(--paper-dim);font:inherit;cursor:pointer}
  .step[aria-selected=true]{border-color:var(--brass);color:var(--paper);background:rgba(201,135,58,.12)}
  .step b{font-family:var(--font-display);color:var(--brass);font-weight:600}
  .group{margin:24px 0 8px}
  .row{padding:12px 0;border-bottom:1px solid var(--rule)}
  .cap{color:var(--paper-dim);font-size:13px;margin-bottom:5px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .val{font-family:var(--font-mono);white-space:pre-wrap;word-break:break-word}
  .chip{font-size:10.5px;letter-spacing:.04em;text-transform:uppercase;font-weight:600;border:1px solid var(--brass-dim);color:var(--brass);border-radius:999px;padding:2px 7px}
  .redacted{display:inline-block;position:relative;background:var(--redact);color:transparent;border-radius:2px;cursor:pointer;padding:1px 3px;user-select:none}
  .redacted::after{content:"";position:absolute;inset:0;border-radius:2px;background:repeating-linear-gradient(-45deg,transparent 0 5px,rgba(0,0,0,.22) 5px 10px)}
  .redacted.lifted{background:transparent;color:var(--paper)}
  .redacted.lifted::after{content:none}
  .btn{padding:9px 14px;border:1px solid var(--rule-strong);border-radius:6px;background:var(--ink-raised);color:var(--paper);font:inherit;cursor:pointer}
  .btn:hover{background:#1A222B}
  .state{padding:64px 0;text-align:center;color:var(--paper-faint)}
  .state h2{font-family:var(--font-display);color:var(--paper-dim);font-size:1.25rem;margin:0 0 8px}
  :focus-visible{outline:2px solid var(--brass);outline-offset:2px}
  @media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap" id="root">
  <div class="state"><h2>Unlocking&hellip;</h2><p>This happens in your browser.</p></div>
</div>

<script>
/* FormKeep share viewer.
   Static file — put it on any host. It never sends the link's key anywhere:
   everything after "#" stays in the browser by design, and the unlocking
   happens right here on this page.

   If you deployed the optional relay, put its address here. Leave it empty
   for link-only sharing. */
const RELAY_URL = "";

const $ = (sel) => document.querySelector(sel);

function b64urlDecode(str){
  const pad = str.length % 4 ? "=".repeat(4 - (str.length % 4)) : "";
  const bin = atob(str.replace(/-/g,"+").replace(/_/g,"/") + pad);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}

async function gunzip(bytes){
  if (typeof DecompressionStream === "undefined") return bytes;
  try {
    const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream("gzip"));
    return new Uint8Array(await new Response(stream).arrayBuffer());
  } catch (_) { return bytes; }
}

async function unlock(payloadB64, keyB64){
  const key = await crypto.subtle.importKey("raw", b64urlDecode(keyB64), {name:"AES-GCM"}, false, ["decrypt"]);
  const joined = b64urlDecode(payloadB64);
  const plain = new Uint8Array(await crypto.subtle.decrypt(
    {name:"AES-GCM", iv: joined.slice(0,12)}, key, joined.slice(12)
  ));
  return JSON.parse(new TextDecoder().decode(await gunzip(plain)));
}

function fail(title, detail){
  $("#root").innerHTML = "";
  const box = document.createElement("div");
  box.className = "state";
  const h = document.createElement("h2"); h.textContent = title;
  const p = document.createElement("p"); p.textContent = detail;
  box.append(h, p);
  $("#root").appendChild(box);
}

function render(data){
  const root = $("#root");
  root.innerHTML = "";

  const eyebrow = document.createElement("span");
  eyebrow.className = "eyebrow";
  eyebrow.textContent = "Shared form answers";
  const title = document.createElement("h1");
  title.textContent = data.title || "Saved answers";
  const meta = document.createElement("p");
  meta.className = "meta";
  const bits = [data.host, new Date(data.capturedAt).toLocaleString()];
  if (data.expiresAt) bits.push("link expires " + new Date(data.expiresAt).toLocaleString());
  if (data.oneTime) bits.push("already deleted from the relay");
  meta.textContent = bits.join("  \u00b7  ");
  root.append(eyebrow, title, meta);

  if (data.note) {
    const note = document.createElement("p");
    note.textContent = data.note;
    root.appendChild(note);
  }

  const notice = document.createElement("div");
  notice.className = "notice";
  notice.innerHTML = "<strong>These are somebody's real answers.</strong> They may include an address, " +
    "an ID number, income or health details. Don't forward this link, and close the tab when you're done.";
  root.appendChild(notice);

  const steps = document.createElement("nav");
  steps.className = "steps";
  const body = document.createElement("section");

  const show = (index) => {
    [...steps.children].forEach((b, i) => b.setAttribute("aria-selected", String(i === index)));
    body.innerHTML = "";
    let lastGroup = Symbol("none");
    for (const field of data.pages[index].fields) {
      if (field.group !== lastGroup) {
        lastGroup = field.group;
        if (field.group) {
          const head = document.createElement("h3");
          head.className = "group eyebrow";
          head.textContent = field.group;
          body.appendChild(head);
        }
      }
      const row = document.createElement("div"); row.className = "row";
      const cap = document.createElement("div"); cap.className = "cap";
      const capText = document.createElement("span"); capText.textContent = field.caption;
      cap.appendChild(capText);
      if (field.sensitivity === "high" || field.sensitivity === "medium") {
        const chip = document.createElement("span");
        chip.className = "chip";
        chip.textContent = "sensitive";
        cap.appendChild(chip);
      }
      const val = document.createElement("div"); val.className = "val";
      const text = field.displayValue || field.value || "";
      if (field.sensitivity === "high") {
        const bar = document.createElement("span");
        bar.className = "redacted";
        bar.textContent = text;
        bar.tabIndex = 0;
        bar.setAttribute("role","button");
        bar.setAttribute("aria-label","Reveal " + field.caption);
        const lift = () => bar.classList.toggle("lifted");
        bar.addEventListener("click", lift);
        bar.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); lift(); }
        });
        val.appendChild(bar);
      } else {
        val.textContent = text;
      }
      row.append(cap, val);
      body.appendChild(row);
    }
  };

  data.pages.forEach((page, index) => {
    const button = document.createElement("button");
    button.className = "step";
    const num = document.createElement("b");
    num.textContent = String(index + 1).padStart(2, "0");
    const name = document.createElement("span");
    name.textContent = page.title || ("Page " + (index + 1));
    button.append(num, name);
    button.addEventListener("click", () => show(index));
    steps.appendChild(button);
  });

  if (data.pages.length > 1) root.appendChild(steps);
  root.appendChild(body);
  show(0);
}

async function main(){
  const params = new URLSearchParams(location.hash.slice(1));
  const key = params.get("k");
  if (!key) return fail("Nothing to open", "This link is missing the part that unlocks it. Ask the sender for the full link \u2014 chat apps sometimes cut long ones in half.");

  let payload = params.get("d");
  if (!payload) {
    const id = params.get("i");
    if (!id) return fail("Nothing to open", "This link doesn't point at anything.");
    if (!RELAY_URL) return fail("Not set up", "This link needs a relay, but this page wasn't configured with one.");
    let response;
    try {
      response = await fetch(RELAY_URL.replace(/\/$/, "") + "/get/" + encodeURIComponent(id));
    } catch (_) {
      return fail("Couldn't reach the relay", "Check your connection and try again.");
    }
    if (response.status === 404) return fail("This link is finished", "It has expired, or it was a one-time link that has already been opened.");
    if (!response.ok) return fail("Couldn't load it", "The relay returned an error (" + response.status + ").");
    payload = (await response.json()).payload;
  }

  let data;
  try { data = await unlock(payload, key); }
  catch (_) { return fail("Couldn't unlock this", "The link is incomplete or was altered on the way here. Ask the sender to send it again."); }

  if (data.expiresAt && Date.now() > data.expiresAt) {
    return fail("This link has expired", "It was set to stop working on " + new Date(data.expiresAt).toLocaleString() + ". Ask the sender for a new one.");
  }
  render(data);
}

main();
</script>
</body>
</html>
